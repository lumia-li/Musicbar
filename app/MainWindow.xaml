                                    Click="NteBackButton_Click"
                                    ToolTip="返回">
                                <Viewbox Width="16"
                                         Height="16"
                                         Margin="-5,0,0,0"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Stretch="Uniform">
                                    <Path Data="M277.382 553.022c-23.136-22.633-23.113-59.378 0.024-82.035l383.961-421.98c23.16-22.657 60.65-22.68 83.786-0.048 23.112 22.657 23.088 59.378-0.048 82.058l-347.407 381.779 346.713 381.035c23.16 22.681 23.401 59.186 0.576 81.555-22.825 22.368-60.122 22.104-83.258-0.553l-383.052-420.97c-0.382-0.361-0.91-0.457-1.294-0.84z"
                                          Fill="#FFFFFFFF"
                                          StrokeThickness="0"/>
                                </Viewbox>
                            </Button>

                            <!-- 展开/折叠列表 -->
                            <Button Grid.Column="1"
                                    x:Name="NteToggleListButton"
                                    Style="{StaticResource NteInlineButtonStyle}"
                                    Click="NteToggleListButton_Click"
                                    ToolTip="展开播放列表">
                                <Image Source="Assets/Nte/列表.png" Width="18" Height="18"/>
                            </Button>

                            <!-- 标题 + 频谱 -->
                            <StackPanel Grid.Column="2"
                                        x:Name="NteTitleStack"
                                        Margin="6,0,6,0"
                                        VerticalAlignment="Center"
                                        MinWidth="0"
                                        HorizontalAlignment="Stretch">
                                <Grid x:Name="NteTitleViewport"
                                      Height="16"
                                      HorizontalAlignment="Stretch"
                                      ClipToBounds="True">
                                    <Canvas ClipToBounds="True">
                                        <TextBlock x:Name="NteTitleText"
                                                   Text="未在播放"
                                                   Foreground="#FFFFFFFF"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   TextWrapping="NoWrap">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform x:Name="NteTitleTransform"
                                                                    X="0"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Canvas>
                                </Grid>
                                <ItemsControl x:Name="NteSpectrumBars"
                                              Height="12"
                                              Margin="0,1,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 导入文件夹 -->
                            <Button Grid.Column="3"
                                    x:Name="NteImportFolderButton"
                                    Style="{StaticResource NteInlineButtonStyle}"
                                    Click="NteImportFolderButton_Click"
                                    ToolTip="选择音乐文件夹（支持子目录，可多选）">
                                <Viewbox Width="18"
                                         Height="18"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Stretch="Uniform">
                                    <Canvas Width="1024" Height="1024">
                                        <Path Data="M855.04 385.024q19.456 2.048 38.912 10.24t33.792 23.04 21.504 37.376 2.048 54.272q-2.048 8.192-8.192 40.448t-14.336 74.24-18.432 86.528-19.456 76.288q-5.12 18.432-14.848 37.888t-25.088 35.328-36.864 26.112-51.2 10.24l-567.296 0q-21.504 0-44.544-9.216t-42.496-26.112-31.744-40.96-12.288-53.76l0-439.296q0-62.464 33.792-97.792t95.232-35.328l503.808 0q22.528 0 46.592 8.704t43.52 24.064 31.744 35.84 12.288 44.032l0 11.264-53.248 0q-40.96 0-95.744-0.512t-116.736-0.512-115.712-0.512-92.672-0.512l-47.104 0q-26.624 0-41.472 16.896t-23.04 44.544q-8.192 29.696-18.432 62.976t-18.432 61.952q-10.24 33.792-20.48 65.536-2.048 8.192-2.048 13.312 0 17.408 11.776 29.184t29.184 11.776q31.744 0 43.008-39.936l54.272-198.656q133.12 1.024 243.712 1.024l286.72 0z"
                                              Fill="#FFFFFFFF"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>

                            <!-- 导入文件 -->
                            <Button Grid.Column="4"
                                    x:Name="NteImportFilesButton"
                                    Style="{StaticResource NteInlineButtonStyle}"
                                    Click="NteImportFilesButton_Click"
                                    ToolTip="选择单个或多个音乐文件">
                                <Viewbox Width="18"
                                         Height="18"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Stretch="Uniform">
                                    <Canvas Width="1024" Height="1024">
                                        <Path Data="M512 153.6v428.885333a193.024 193.024 0 0 0-93.866667-24.917333 182.101333 182.101333 0 1 0 0 364.032 184.832 184.832 0 0 0 187.733334-182.101333V284.501333h96.768a91.136 91.136 0 0 0 90.965333-91.136A90.965333 90.965333 0 0 0 702.634667 102.4H563.2a51.2 51.2 0 0 0-51.2 51.2z"
                                              Fill="#FFFFFFFF"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>

                            <!-- 上一首 -->
                            <Button Grid.Column="6"
                                    x:Name="NtePrevButton"
                                    Style="{StaticResource NteInlineButtonStyle}"
                                    Click="NtePrevButton_Click"
                                    ToolTip="上一首">
                                <Image Source="Assets/Nte/上一首.png" Width="18" Height="18"/>
                            </Button>

                            <!-- 播放/暂停 -->
                            <Button Grid.Column="7"
                                    x:Name="NtePlayButton"
                                    Style="{StaticResource NteInlineButtonStyle}"
                                    Click="NtePlayButton_Click"
                                    ToolTip="播放/暂停">
                                <Image x:Name="NtePlayIcon"
                                       Source="Assets/Nte/继续.png"
                                       Width="18"
                                       Height="18"/>
                            </Button>

                            <!-- 下一首 -->
                            <Button Grid.Column="8"
                                    x:Name="NteNextButton"
                                    Style="{StaticResource NteInlineButtonStyle}"
                                    Click="NteNextButton_Click"
                                    ToolTip="下一首">
                                <Image Source="Assets/Nte/下一首.png" Width="18" Height="18"/>
                            </Button>

                            <!-- 播放模式 -->
                            <Button Grid.Column="9"
                                    x:Name="NteModeButton"
                                    Style="{StaticResource NteInlineButtonStyle}"
                                    Click="NteModeButton_Click"
                                    ToolTip="播放模式">
                                <Image x:Name="NteModeIcon"
                                       Source="Assets/Nte/列表循环.png"
                                       Width="18"
                                       Height="18"/>
                            </Button>

                            <!-- 爱心（只看收藏） -->
                            <Button Grid.Column="10"
                                    x:Name="NteFavoriteFilterButton"
                                    Style="{StaticResource NteInlineButtonStyle}"
                                    Click="NteFavoriteFilterButton_Click"
                                    ToolTip="只看收藏">
                                <Image x:Name="NteFavoriteFilterIcon"
                                       Source="Assets/Nte/爱心.png"
                                       Width="18"
                                       Height="18"/>
                            </Button>

                            <!-- 当前曲的爱心（快速收藏/取消收藏） -->
                            <Button Grid.Column="11"
                                    x:Name="NteLikeCurrentButton"
                                    Style="{StaticResource NteInlineButtonStyle}"
                                    Click="NteLikeCurrentButton_Click"
                                    ToolTip="收藏当前曲目">
                                <Image x:Name="NteLikeCurrentImage"
                                       Source="Assets/Nte/爱心.png"
                                       Width="18"
                                       Height="18"
                                       Opacity="0.6"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 副标题/状态条（在控制栏下方） -->
                    <Grid x:Name="NteStatusBar"
                          Grid.Row="1"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          Margin="0,2,0,0">
                        <TextBlock x:Name="NteSubtitleText"
                                   Text="点击文件夹图标选择音乐文件夹；或点击音符图标选择单个音乐文件"
                                   Foreground="#99FFFFFF"
                                   FontSize="10"
                                   HorizontalAlignment="Left"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- 可折叠的播放列表 -->
                    <Grid x:Name="NtePlaylistGrid"
                          Grid.Row="2"
                          Grid.Column="2"
                          Panel.ZIndex="1"
                          Visibility="Collapsed"
                          Margin="0,6,0,0"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="NtePlaylistTransform"/>
                        </Grid.RenderTransform>
                        <Border x:Name="NtePlaylistPanel"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="#1FFFFFFF"
                                Background="#B30F141E">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="3"
                                                  Direction="315"
                                                  Opacity="0.38"/>
                            </Border.Effect>
                            <Grid Margin="6,14,6,6">
                            <ListBox x:Name="NteSongList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#FFDDDDDD"
                                     SelectionChanged="NteSongList_SelectionChanged"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch"
                                     MinHeight="0">
                            <ListBox.Resources>
                                <Style x:Key="NteScrollBarRepeatButtonStyle" TargetType="RepeatButton">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="IsTabStop" Value="False"/>
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style x:Key="NteVerticalScrollBarThumbStyle" TargetType="Thumb">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Width="4"
                                                        Margin="2,0"
                                                        CornerRadius="2"
                                                        Background="#72FFFFFF"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#AAFFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#FFFF007F"/>
                                                        <Setter TargetName="ThumbBorder" Property="Width" Value="5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style x:Key="NteVerticalScrollBarStyle" TargetType="ScrollBar">
                                    <Setter Property="Width" Value="8"/>
                                    <Setter Property="MinWidth" Value="8"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ScrollBar">
                                                <Grid Background="Transparent">
                                                    <Track x:Name="PART_Track"
                                                           IsDirectionReversed="True">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                                          Style="{StaticResource NteScrollBarRepeatButtonStyle}"/>
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb Style="{StaticResource NteVerticalScrollBarThumbStyle}"/>
                                                        </Track.Thumb>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                                          Style="{StaticResource NteScrollBarRepeatButtonStyle}"/>
                                                        </Track.IncreaseRepeatButton>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource NteVerticalScrollBarStyle}">
                                    <Style.Triggers>
                                        <Trigger Property="Orientation" Value="Horizontal">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Resources>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFDDDDDD"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFDDDDDD"/>
                                    </Style.Resources>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            </ListBox>
                            </Grid>
                        </Border>
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="8,-6,0,0"
                                Padding="4,0"
                                Background="#B30F141E"
                                IsHitTestVisible="False">
                            <TextBlock Text="全部歌曲"
                                       Foreground="#FFFFFFFF"
                                       FontSize="14"
                                       FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Grid>
                </Grid>
            </Border>
        </Border>

        <Popup x:Name="PlayerPickerPopup"
               IsOpen="{Binding IsChecked, ElementName=SourcePickerToggleButton, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=WidgetBorder}"
               Placement="Custom"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="False"
               Loaded="PlayerPickerPopup_Loaded"
               Opened="PlayerPickerPopup_Opened"
               Closed="PlayerPickerPopup_Closed">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="PlayerPickerPanel"
                        Padding="10,8"
                        CornerRadius="12"
                        BorderThickness="0"
                        BorderBrush="Transparent"
                        Background="{DynamicResource ContextMenuBackgroundBrush}">
                    <StackPanel Orientation="Horizontal">
                    <Button x:Name="PlayerTargetAutoButton"
                            Click="PlayerTargetAutoButton_Click"
                            Style="{StaticResource ControlButtonStyle}"
                            Width="44"
                            Height="32"
                            Margin="2,0">
                        <TextBlock Text="默认"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"/>
                    </Button>

                    <Button x:Name="PlayerTargetQqButton"
                            Click="PlayerTargetQqButton_Click"
                            Style="{StaticResource ControlButtonStyle}"
                            Width="32"
                            Height="32"
                            Margin="6,0,2,0">
                        <Image Source="Assets/Logos/qq.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"/>
                    </Button>

                    <Button x:Name="PlayerTargetNeteaseButton"
                            Click="PlayerTargetNeteaseButton_Click"
                            Style="{StaticResource ControlButtonStyle}"
                            Width="32"
                            Height="32"
                            Margin="2,0">
                        <Image Source="Assets/Logos/netease.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"/>
                    </Button>

                    <Button x:Name="PlayerTargetSpotifyButton"
                            Click="PlayerTargetSpotifyButton_Click"
                            Style="{StaticResource ControlButtonStyle}"
                            Width="32"
                            Height="32"
                            Margin="2,0">
                        <Image Source="Assets/Logos/spotify.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"/>
                    </Button>

                    <Button x:Name="PlayerTargetKugouButton"
                            Click="PlayerTargetKugouButton_Click"
                            Style="{StaticResource ControlButtonStyle}"
                            Width="36"
                            Height="32"
                            Margin="2,0">
                        <Image Source="Assets/Logos/kugou.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"/>
                    </Button>

                    <Button x:Name="PlayerTargetSodaButton"
                            Click="PlayerTargetSodaButton_Click"
                            Style="{StaticResource ControlButtonStyle}"
                            Width="32"
                            Height="32"
                            Margin="2,0,0,0">
                        <Image Source="Assets/Logos/soda.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"/>
                    </Button>
                    </StackPanel>
                </Border>

                <Button x:Name="NteLogoSelectorPanel"
                        Style="{StaticResource NteSelectorButtonStyle}"
                        Click="NteLogoSelectorPanel_Click">
                    <Image Source="Assets/Logos/nte.png"
                           Width="30"
                           Height="30"
                           Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Popup>

        <Popup x:Name="FloatingProgressPopup"
               PlacementTarget="{Binding ElementName=WidgetBorder}"
               Placement="Custom"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="True">
            <Border x:Name="FloatingProgressPopupPanel"
                    MinWidth="220"
                    Padding="10,8"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource WidgetBorderBrush}"
                    Background="{DynamicResource FloatingProgressBackgroundBrush}">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="FloatingProgressCurrentText"
                                   Text="0:00"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="FloatingProgressDurationText"
                                   Text="--:--"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid x:Name="FloatingProgressTrackHost"
                          Height="12"
                          Margin="0,3,0,0"
                          Background="Transparent"
                          Cursor="Hand"
                          MouseLeftButtonDown="Progress_MouseLeftButtonDown"
                          MouseMove="Progress_MouseMove"
                          MouseLeftButtonUp="Progress_MouseLeftButtonUp"
                          MouseLeave="Progress_MouseLeave">
                        <Border x:Name="FloatingProgressTrack"
                                Height="3"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ProgressTrackBrush}"
                                CornerRadius="1.5"
                                IsHitTestVisible="False"/>
                        <Border x:Name="FloatingProgressFill"
                                Height="3"
                                Width="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource ProgressFillBrush}"
                                CornerRadius="1.5"
                                IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

    </Grid>
</Window>
