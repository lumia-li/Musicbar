                                    <Thumb Width="20" Height="20"
                                           Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="20" Height="20">
                                                    <Border x:Name="ThumbBorder"
                                                            Width="14" Height="14"
                                                            CornerRadius="7"
                                                            Background="#FFF3F7FF"
                                                            BorderThickness="0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
