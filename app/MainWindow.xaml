        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeartButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ControlButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="ControlToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CornerRadiusResetButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <TextBlock x:Name="ValueText"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{DynamicResource ContextMenuTextBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                            <Viewbox x:Name="ResetIcon"
                                     Width="14"
                                     Height="14"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     Opacity="0">
                                <Canvas Width="1024" Height="1024"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Canvas.RenderTransform>
                                        <ScaleTransform ScaleX="-1" ScaleY="1"/>
                                    </Canvas.RenderTransform>
                                    <Path Data="{StaticResource CornerRadiusResetIconGeometry}"
                                          Fill="{DynamicResource ContextMenuTextBrush}"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ValueText"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ResetIcon"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ValueText"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ResetIcon"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ContextMenuBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ContextMenuBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ContextMenuTextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="4">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource ContextMenuTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="ItemRoot"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Grid MinWidth="124">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center">
                                        <TextBlock x:Name="CheckMark"
                                                   Text="✓"
                                                   Foreground="{DynamicResource ContextMenuTextBrush}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Opacity="0"/>
                                        <Path x:Name="SubmenuArrow"
                                              Data="M0,0 L4,4 L0,8"
                                              Stroke="{DynamicResource ContextMenuTextBrush}"
                                              StrokeThickness="1.4"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"
                                              Opacity="0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Custom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   Loaded="SubmenuPopup_Loaded"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource ContextMenuBackgroundBrush}"
                                        BorderBrush="{DynamicResource ContextMenuBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="4">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemRoot"
                                        Property="Background"
                                        Value="{DynamicResource ContextMenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow"
                                        Property="Opacity"
                                        Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark"
                                        Property="Opacity"
                                        Value="0.9"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="HasItems" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CheckMark"
                                        Property="Opacity"
                                        Value="0"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContextMenuPanelItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右键菜单圆角 Slider 样式 -->
        <Style x:Key="ContextMenuSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="{TemplateBinding Height}">
                            <!-- 轨道背景 -->
                            <Border Height="3"
                                    CornerRadius="1.5"
                                    Background="#30FFFFFF"
                                    VerticalAlignment="Center"/>
                            <!-- 已填充轨道（选择后左侧） -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3"
                                                        CornerRadius="1.5"
                                                        Background="#B0F3F7FF"
                                                        HorizontalAlignment="Left"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20"
                                           Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="20" Height="20">
                                                    <Border x:Name="ThumbBorder"
                                                            Width="14" Height="14"
                                                            CornerRadius="7"
                                                            Background="#FFF3F7FF"
                                                            BorderThickness="0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="4"
                                                                              ShadowDepth="0"
                                                                              Opacity="0.35"
                                                                              Color="#000000"/>
                                                        </Border.Effect>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="#FFFFFFFF"/>
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Width"
                                                                Value="16"/>
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Height"
                                                                Value="16"/>
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="CornerRadius"
                                                                Value="8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="#FFFFFFFF"/>
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Width"
                                                                Value="16"/>
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Height"
                                                                Value="16"/>
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="CornerRadius"
                                                                Value="8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid MouseLeftButtonDown="Root_MouseLeftButtonDown"
          MouseMove="Root_MouseMove"
          MouseLeftButtonUp="Root_MouseLeftButtonUp">

        <Grid.ContextMenu>
            <ContextMenu Style="{StaticResource WidgetContextMenuStyle}"
                         Opened="WidgetContextMenu_Opened"
                         Closed="WidgetContextMenu_Closed">
                <MenuItem Header="时间条"
                          Style="{StaticResource WidgetContextMenuItemStyle}">
                    <MenuItem x:Name="InlineProgressModeMenuItem"
                              Header="固定下边栏"
                              Style="{StaticResource WidgetContextMenuItemStyle}"
                              Click="InlineProgressModeMenuItem_Click"/>
                    <MenuItem x:Name="FloatingProgressModeMenuItem"
                              Header="悬浮下方"
                              Style="{StaticResource WidgetContextMenuItemStyle}"
                              Click="FloatingProgressModeMenuItem_Click"/>
                    <MenuItem x:Name="HiddenProgressModeMenuItem"
                              Header="不显示时间条"
                              Style="{StaticResource WidgetContextMenuItemStyle}"
                              Click="HiddenProgressModeMenuItem_Click"/>
                </MenuItem>
                <MenuItem Header="个性化"
                          Style="{StaticResource WidgetContextMenuItemStyle}">
                    <MenuItem x:Name="CornerRadiusMenuItem"
                              Header="调节圆角"
                              Style="{StaticResource WidgetContextMenuItemStyle}">
                        <MenuItem x:Name="CornerRadiusSliderMenuItem"
                                  Style="{StaticResource ContextMenuPanelItemStyle}"
                                  StaysOpenOnClick="True">
                            <MenuItem.Header>
                                <Grid Width="156" Margin="8,2,6,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="圆角"
                                               Foreground="{DynamicResource ContextMenuTextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Slider x:Name="CornerRadiusSlider"
                                            Grid.Column="1"
                                            Style="{StaticResource ContextMenuSliderStyle}"
                                            Width="78"
                                            Minimum="0" Maximum="23"
                                            SmallChange="1" LargeChange="2"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="1"
                                            VerticalAlignment="Center"
                                            ValueChanged="CornerRadiusSlider_ValueChanged"/>
                                    <Button x:Name="CornerRadiusResetButton"
                                            Grid.Column="2"
                                            Style="{StaticResource CornerRadiusResetButtonStyle}"
                                            Content="12"
                                            Click="CornerRadiusResetButton_Click"/>
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="颜色主题"
                              Style="{StaticResource WidgetContextMenuItemStyle}">
                        <MenuItem x:Name="LightThemeMenuItem"
                                  Header="浅色"
                                  Tag="Light"
                                  Style="{StaticResource WidgetContextMenuItemStyle}"
                                  IsCheckable="True"
                                  StaysOpenOnClick="True"
                                  Click="ThemeMenuItem_Click"/>
                        <MenuItem x:Name="DarkThemeMenuItem"
                                  Header="深色"
                                  Tag="Dark"
                                  Style="{StaticResource WidgetContextMenuItemStyle}"
                                  IsCheckable="True"
                                  StaysOpenOnClick="True"
                                  Click="ThemeMenuItem_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="OpacityMenuItem"
                              Header="透明度"
                              Style="{StaticResource WidgetContextMenuItemStyle}">
                        <MenuItem x:Name="OpacitySliderMenuItem"
                                  Style="{StaticResource ContextMenuPanelItemStyle}"
                                  StaysOpenOnClick="True">
                            <MenuItem.Header>
                                <Grid Width="156" Margin="8,2,6,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="透明度"
                                               Foreground="{DynamicResource ContextMenuTextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Slider x:Name="WidgetOpacitySlider"
                                            Grid.Column="1"
                                            Style="{StaticResource ContextMenuSliderStyle}"
                                            Width="78"
                                            Minimum="20" Maximum="100"
                                            SmallChange="1" LargeChange="5"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="1"
                                            VerticalAlignment="Center"
                                            ValueChanged="WidgetOpacitySlider_ValueChanged"/>
                                    <TextBlock x:Name="WidgetOpacityValueText"
                                               Grid.Column="2"
                                               Text="100"
                                               Foreground="{DynamicResource ContextMenuTextBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem x:Name="GradientMenuItem"
                              Header="渐变色"
                              Style="{StaticResource WidgetContextMenuItemStyle}">
                        <MenuItem x:Name="GradientEnabledMenuItem"
                                  Header="启用渐变色"
                                  Style="{StaticResource WidgetContextMenuItemStyle}"
                                  IsCheckable="True"
                                  Click="GradientEnabledMenuItem_Click"/>
                        <MenuItem x:Name="GradientTypeMenuItem"
                                  Header="渐变类型"
                                  Style="{StaticResource WidgetContextMenuItemStyle}">
                            <MenuItem x:Name="GradientLinearMenuItem"
                                      Header="线性"
                                      Style="{StaticResource WidgetContextMenuItemStyle}"
                                      IsCheckable="True"
                                      Click="GradientLinearMenuItem_Click"/>
                            <MenuItem x:Name="GradientRadialMenuItem"
                                      Header="径向"
                                      Style="{StaticResource WidgetContextMenuItemStyle}"
                                      IsCheckable="True"
                                      Click="GradientRadialMenuItem_Click"/>
                            <MenuItem x:Name="GradientAngleMenuItem"
                                      Header="角度"
                                      Style="{StaticResource WidgetContextMenuItemStyle}"
                                      IsCheckable="True"
                                      Click="GradientAngleMenuItem_Click"/>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem x:Name="MainSpectrumMenuItem"
                              Header="音乐频谱"
                              Style="{StaticResource WidgetContextMenuItemStyle}">
                        <MenuItem x:Name="MainSpectrumEnabledMenuItem"
                                  Header="启用"
                                  Style="{StaticResource WidgetContextMenuItemStyle}"
                                  IsCheckable="True"
                                  Click="MainSpectrumEnabledMenuItem_Click"/>
                        <MenuItem x:Name="MainSpectrumTopPositionMenuItem"
                                  Header="上方"
                                  Style="{StaticResource WidgetContextMenuItemStyle}"
                                  IsCheckable="True"
                                  Click="MainSpectrumTopPositionMenuItem_Click"/>
                        <MenuItem x:Name="MainSpectrumBottomPositionMenuItem"
                                  Header="下方"
                                  Style="{StaticResource WidgetContextMenuItemStyle}"
                                  IsCheckable="True"
                                  Click="MainSpectrumBottomPositionMenuItem_Click"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem x:Name="SoundEffectMenu"
                          Header="氛围音效"
                          Style="{StaticResource WidgetContextMenuItemStyle}">
                    <MenuItem x:Name="SoundEffectEnabledMenuItem"
                              Header="启用音效"
                              Style="{StaticResource WidgetContextMenuItemStyle}"
                              IsCheckable="True"
                              Click="SoundEffectEnabledMenuItem_Click"/>
                    <MenuItem x:Name="SoundEffectSelectorMenuItem"
                              Header="选择音效"
                              Style="{StaticResource WidgetContextMenuItemStyle}">
                        <!-- 动态填充音效文件列表 -->
                    </MenuItem>
                    <MenuItem x:Name="SoundEffectVolumeMenuItem"
                              Header="音量"
                              Style="{StaticResource WidgetContextMenuItemStyle}">
                        <MenuItem x:Name="SoundEffectVolumePanelMenuItem"
                                  Style="{StaticResource ContextMenuPanelItemStyle}"
                                  StaysOpenOnClick="True">
                            <MenuItem.Header>
                                <Grid Width="156" Margin="8,2,6,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="音量"
                                               Foreground="{DynamicResource ContextMenuTextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Slider x:Name="SoundEffectVolumeSlider"
                                            Grid.Column="1"
                                            Style="{StaticResource ContextMenuSliderStyle}"
                                            Width="78"
                                            Minimum="0" Maximum="100"
                                            SmallChange="1" LargeChange="10"
                                            TickFrequency="10"
                                            IsSnapToTickEnabled="False"
                                            VerticalAlignment="Center"
                                            ValueChanged="SoundEffectVolumeSlider_ValueChanged"/>
                                    <TextBlock x:Name="SoundEffectVolumeValueText"
                                               Grid.Column="2"
                                               Text="50"
                                               Foreground="{DynamicResource ContextMenuTextBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                    </MenuItem>
                </MenuItem>
                <MenuItem Style="{StaticResource WidgetContextMenuItemStyle}"
                          PreviewMouseRightButtonDown="CloseProgramMenuItem_PreviewMouseRightButtonDown"
                          PreviewMouseRightButtonUp="CloseProgramMenuItem_PreviewMouseRightButtonUp"
                          Click="CloseProgramMenuItem_Click">
                    <MenuItem.Header>
                        <TextBlock Text="关闭程序"
                                   Foreground="#FFFF5A5F"/>
                    </MenuItem.Header>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <Border x:Name="WidgetBorder"
                CornerRadius="12"
                BorderBrush="Transparent"
                BorderThickness="0"
                RenderTransformOrigin="0.5,0.5"
                SnapsToDevicePixels="True"
                MouseEnter="WidgetBorder_MouseEnter"
                MouseLeave="WidgetBorder_MouseLeave">
            <Border.RenderTransform>
                <ScaleTransform x:Name="WidgetRestoreScaleTransform"
                                ScaleX="1"
                                ScaleY="1"/>
            </Border.RenderTransform>
            <Border x:Name="WidgetBackgroundHost"
                    CornerRadius="12"
                    Margin="0"
                    Background="Transparent"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid x:Name="SystemPlayerPage"
                          Panel.ZIndex="1">
                <Grid x:Name="MainSpectrumHost"
                      Height="16"
                      Margin="9,0,9,0"
                      VerticalAlignment="Top"
                      Panel.ZIndex="0"
                      IsHitTestVisible="False"
                      ClipToBounds="True"
                      UseLayoutRounding="True"
                      SnapsToDevicePixels="True"
                      Visibility="Collapsed">
                    <ItemsControl x:Name="MainSpectrumBars"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top"
                                  UseLayoutRounding="True"
                                  SnapsToDevicePixels="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            UseLayoutRounding="True"
                                            SnapsToDevicePixels="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
                <Grid Margin="9,5"
                      Panel.ZIndex="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ToggleButton Grid.Column="0"
                              x:Name="SourcePickerToggleButton"
                              Style="{StaticResource ControlToggleButtonStyle}"
                              Width="24"
                              Height="24"
                              Margin="0,0,4,0"
                              Checked="SourcePickerToggleButton_Checked"
                              Unchecked="SourcePickerToggleButton_Unchecked"
                              ClickMode="Press">
                    <Viewbox Width="11" Height="11"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center">
                        <Path x:Name="SourcePickerToggleGlyph"
                              Fill="{DynamicResource IconBrush}"
                              Stretch="Uniform"
                              Data="M854.016 739.328l-313.344-309.248-313.344 309.248q-14.336 14.336-32.768 21.504t-37.376 7.168-36.864-7.168-32.256-21.504q-29.696-28.672-29.696-68.608t29.696-68.608l376.832-373.76q14.336-14.336 34.304-22.528t40.448-9.216 39.424 5.12 31.232 20.48l382.976 379.904q28.672 28.672 28.672 68.608t-28.672 68.608q-14.336 14.336-32.768 21.504t-37.376 7.168-36.864-7.168-32.256-21.504">
                            <Path.RenderTransform>
                                <ScaleTransform x:Name="SourcePickerToggleScale"
                                                CenterX="512"
                                                CenterY="512"
                                                ScaleY="1"/>
                            </Path.RenderTransform>
                        </Path>
                    </Viewbox>
                </ToggleButton>

                <Border Grid.Column="1"
                        x:Name="AlbumArtHitArea"
                        Width="30"
                        Height="30"
                        CornerRadius="6"
                        ClipToBounds="True"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AlbumPlaceholderBrush}"
                        Cursor="Hand"
                        MouseEnter="AlbumArtHitArea_MouseEnter"
                        MouseLeave="AlbumArtHitArea_MouseLeave"
                        MouseLeftButtonDown="AlbumArtHitArea_MouseLeftButtonDown"
                        MouseLeftButtonUp="AlbumArtHitArea_MouseLeftButtonUp">
                    <Grid>
                        <Image x:Name="AlbumArtImage"
                               Stretch="UniformToFill">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,30,30"
                                                   RadiusX="6"
                                                   RadiusY="6"/>
                            </Image.Clip>
                        </Image>
                        <Viewbox x:Name="AlbumArtFallback"
                                 Width="18"
                                 Height="18"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Canvas Width="1024" Height="1024">
                                <Rectangle Width="1024"
                                           Height="1024"
                                           Fill="Transparent"/>
                                <Path Data="M512 153.6v428.885333a193.024 193.024 0 0 0-93.866667-24.917333 182.101333 182.101333 0 1 0 0 364.032 184.832 184.832 0 0 0 187.733334-182.101333V284.501333h96.768a91.136 91.136 0 0 0 90.965333-91.136A90.965333 90.965333 0 0 0 702.634667 102.4H563.2a51.2 51.2 0 0 0-51.2 51.2z"
                                      Fill="#FFFFFFFF"/>
                            </Canvas>
                        </Viewbox>
                        <Border x:Name="AlbumArtHoverShade"
                                Opacity="0"
                                IsHitTestVisible="False"
                                CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="0,1">
                                    <GradientStop Color="#20000000"
                                                  Offset="0"/>
                                    <GradientStop Color="#B0000000"
                                                  Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="AlbumArtHoverBadge"
                                Width="22"
                                Height="22"
                                Visibility="Collapsed"
                                Opacity="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="AlbumArtHoverBadgeScale"
                                                ScaleX="0.9"
                                                ScaleY="0.9"/>
                            </Border.RenderTransform>
                            <Viewbox Width="18"
                                     Height="18"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Line X1="12.8" Y1="12.8" X2="19.8" Y2="19.8"
                                          Stroke="#FFF7FAFF"
                                          StrokeThickness="2.1"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                    <Polyline Points="19.8,12.2 19.8,19.8 12.2,19.8"
                                              Fill="Transparent"
                                              Stroke="#FFF7FAFF"
                                              StrokeThickness="2.1"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                    <Line X1="11.2" Y1="11.2" X2="4.2" Y2="4.2"
                                          Stroke="#FFF7FAFF"
                                          StrokeThickness="2.1"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                    <Polyline Points="4.2,11.8 4.2,4.2 11.8,4.2"
                                              Fill="Transparent"
                                              Stroke="#FFF7FAFF"
                                              StrokeThickness="2.1"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2"
                            Margin="6,0,4,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="SongTitleText"
                               Text="Hope So"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ArtistText"
                               Text="纯音乐，请欣赏"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="10.5"
                               TextTrimming="CharacterEllipsis"/>
                    <Grid x:Name="LyricLineHost"
                          Height="15"
                          ClipToBounds="True"
                          Visibility="Collapsed">
                        <Canvas x:Name="LyricTrackCanvas"
                                Height="15">
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="LyricTrackTransform"
                                                    X="0"/>
                            </Canvas.RenderTransform>
                            <TextBlock x:Name="LyricBaseText"
                                       Text=""
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap"/>
                            <TextBlock x:Name="LyricPlayedText"
                                       Text=""
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap">
                                <TextBlock.Clip>
                                    <RectangleGeometry x:Name="LyricPlayedClip"
                                                       Rect="0,0,0,15"/>
                                </TextBlock.Clip>
                            </TextBlock>
                        </Canvas>
                    </Grid>
                </StackPanel>

                <Button Grid.Column="3"
                        x:Name="ActivePlayerLogoButton"
                        Style="{StaticResource ControlButtonStyle}"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"
                        Opacity="0.92">
                    <Border Width="22"
                            Height="22"
                            CornerRadius="11"
                            Background="#18FFFFFF"
                            BorderThickness="1"
                            BorderBrush="#28FFFFFF">
                        <Image x:Name="ActivePlayerLogoImage"
                               Width="14"
                               Height="14"
                               Stretch="Uniform"/>
                    </Border>
                </Button>

                <Button Grid.Column="4"
                        x:Name="PrevButton"
                        Click="PrevButton_Click"
                        Style="{StaticResource ControlButtonStyle}">
                    <Viewbox Width="13" Height="13">
                        <Path Data="{StaticResource PrevIconGeometry}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Uniform"/>
                    </Viewbox>
                </Button>

                <Button Grid.Column="5"
                        x:Name="PlayPauseButton"
                        Click="PlayPauseButton_Click"
                        Style="{StaticResource ControlButtonStyle}">
                    <Grid Width="14" Height="14">
                        <Viewbox Width="14" Height="14" x:Name="PlayIconViewbox" Visibility="Collapsed">
                            <Path Data="{StaticResource PlayIconGeometry}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform"/>
                        </Viewbox>
                        <Viewbox Width="14" Height="14" x:Name="PauseIconViewbox">
                            <Path Data="{StaticResource PauseIconGeometry}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform"/>
                        </Viewbox>
                    </Grid>
                </Button>

                <Button Grid.Column="6"
                        x:Name="NextButton"
                        Click="NextButton_Click"
                        Style="{StaticResource ControlButtonStyle}">
                    <Viewbox Width="13" Height="13">
                        <Path Data="{StaticResource NextIconGeometry}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Uniform"/>
                    </Viewbox>
                </Button>

                <Button Grid.Column="7"
                        x:Name="DefaultPlaybackModeButton"
                        Click="DefaultPlaybackModeButton_Click"
                        Style="{StaticResource ControlButtonStyle}"
                        ToolTip="顺序播放">
                    <Image x:Name="DefaultPlaybackModeIcon"
                           Source="Assets/Playback/列表.png"
                           Width="18"
                           Height="18"
                           Stretch="Uniform"/>
                </Button>

                <Button Grid.Column="8"
                        x:Name="LikeButton"
                        Click="LikeButton_Click"
                        Style="{StaticResource HeartButtonStyle}">
                    <Viewbox Width="14" Height="14">
                        <Path Data="{StaticResource HeartIconGeometry}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Uniform"/>
                    </Viewbox>
                </Button>
                </Grid>
                    <Grid x:Name="InlineProgressHost"
                          Height="12"
                          Margin="8,0,8,0"
                          VerticalAlignment="Bottom"
                          Background="Transparent"
                          Cursor="Hand"
                          MouseLeftButtonDown="Progress_MouseLeftButtonDown"
                          MouseMove="Progress_MouseMove"
                          MouseLeftButtonUp="Progress_MouseLeftButtonUp"
                          MouseLeave="Progress_MouseLeave">
                        <Border x:Name="InlineProgressTrack"
                                Height="2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ProgressTrackBrush}"
                                CornerRadius="1"
                                IsHitTestVisible="False"/>
                        <Border x:Name="InlineProgressFill"
                                Height="2"
                                Width="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource ProgressFillBrush}"
                                CornerRadius="1"
                                IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
                </Grid>
            </Border>
        </Border>

        <Popup x:Name="PlayerPickerPopup"
               IsOpen="{Binding IsChecked, ElementName=SourcePickerToggleButton, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=WidgetBorder}"
               Placement="Custom"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="False"
               Loaded="PlayerPickerPopup_Loaded"
               Opened="PlayerPickerPopup_Opened"
               Closed="PlayerPickerPopup_Closed">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="PlayerPickerPanel"
                        Padding="10,8"
                        CornerRadius="12"
                        BorderThickness="0"
                        BorderBrush="Transparent"
                        Background="{DynamicResource ContextMenuBackgroundBrush}">
                    <StackPanel Orientation="Horizontal">
                    <Button x:Name="PlayerTargetAutoButton"
                            Click="PlayerTargetAutoButton_Click"
                            Style="{StaticResource ControlButtonStyle}"
                            Width="44"
                            Height="32"
                            Margin="2,0">
                        <TextBlock Text="默认"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"/>
                    </Button>

                    <Button x:Name="PlayerTargetQqButton"
                            Click="PlayerTargetQqButton_Click"
                            Style="{StaticResource ControlButtonStyle}"
                            Width="32"
                            Height="32"
                            Margin="6,0,2,0">
                        <Image Source="Assets/Logos/qq.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"/>
                    </Button>

                    <Button x:Name="PlayerTargetNeteaseButton"
                            Click="PlayerTargetNeteaseButton_Click"
                            Style="{StaticResource ControlButtonStyle}"
                            Width="32"
                            Height="32"
                            Margin="2,0">
                        <Image Source="Assets/Logos/netease.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"/>
                    </Button>

                    <Button x:Name="PlayerTargetSpotifyButton"
                            Click="PlayerTargetSpotifyButton_Click"
                            Style="{StaticResource ControlButtonStyle}"
                            Width="32"
                            Height="32"
                            Margin="2,0">
                        <Image Source="Assets/Logos/spotify.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"/>
                    </Button>

                    <Button x:Name="PlayerTargetKugouButton"
                            Click="PlayerTargetKugouButton_Click"
                            Style="{StaticResource ControlButtonStyle}"
                            Width="36"
                            Height="32"
                            Margin="2,0">
                        <Image Source="Assets/Logos/kugou.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"/>
                    </Button>

                    <Button x:Name="PlayerTargetSodaButton"
                            Click="PlayerTargetSodaButton_Click"
                            Style="{StaticResource ControlButtonStyle}"
                            Width="32"
                            Height="32"
                            Margin="2,0,0,0">
                        <Image Source="Assets/Logos/soda.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"/>
                    </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Popup>

        <Popup x:Name="FloatingProgressPopup"
               PlacementTarget="{Binding ElementName=WidgetBorder}"
               Placement="Custom"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="True">
            <Border x:Name="FloatingProgressPopupPanel"
                    MinWidth="220"
                    Padding="10,8"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource WidgetBorderBrush}"
                    Background="{DynamicResource FloatingProgressBackgroundBrush}">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="FloatingProgressCurrentText"
                                   Text="0:00"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="FloatingProgressDurationText"
                                   Text="--:--"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid x:Name="FloatingProgressTrackHost"
                          Height="12"
                          Margin="0,3,0,0"
                          Background="Transparent"
                          Cursor="Hand"
                          MouseLeftButtonDown="Progress_MouseLeftButtonDown"
                          MouseMove="Progress_MouseMove"
                          MouseLeftButtonUp="Progress_MouseLeftButtonUp"
                          MouseLeave="Progress_MouseLeave">
                        <Border x:Name="FloatingProgressTrack"
                                Height="3"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ProgressTrackBrush}"
                                CornerRadius="1.5"
                                IsHitTestVisible="False"/>
                        <Border x:Name="FloatingProgressFill"
                                Height="3"
                                Width="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource ProgressFillBrush}"
                                CornerRadius="1.5"
                                IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <FrameworkElement x:Name="TrayMenuHost" Visibility="Collapsed"/>
    </Grid>
</Window>
