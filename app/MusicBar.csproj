<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Copyright>Copyright © 2026 liyue</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon\*.png" />
    <Resource Include="Assets\Logos\*.png" />
    <Resource Include="Assets\Playback\*.png" />
    <Resource Include="Assets\TrayIcon\tray.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

</Project>
